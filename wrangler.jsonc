// Installazione Cloudflare di Ricette di famiglia & Co. (SPEC §32, §34, docs/CLOUDFLARE.md):
// l'app solo su app.ricettedifamiglia.online; il dominio principale è del Worker del sito (sito/).
// Rilascio solo manuale: scripts/cloudflare/rilascia.sh. Nessun collegamento Git.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menuapp",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.ricettedifamiglia.online", "custom_domain": true }],
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "ARCHIVIO", "class_name": "Archivio" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Archivio"] }],
  "r2_buckets": [{ "binding": "FOTO", "bucket_name": "menuapp-foto" }],
  "triggers": { "crons": ["45 2 * * *"] },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": { "MENUAPP_URL_PUBBLICO": "https://app.ricettedifamiglia.online" },
  "observability": { "enabled": true }
}
